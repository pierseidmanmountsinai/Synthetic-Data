# ---- Generator: the frozen PART 1 chunks, loaded unchanged ----
rmd <- readLines(part1_file)
chunk_code <- function(label) {
  start <- grep(paste0("^```\\{r ", label), rmd)
  end <- grep("^```\\s*$", rmd); end <- end[end > start][1]
  rmd[(start + 1):(end - 1)]
}
walk(c("generator-main", "generator-model", "generator-helpers"), ~ eval(parse(text = chunk_code(.x)), envir = globalenv()))

