## Validation Functions (NEW)

Transfer test: run the same analyses on the real data and on several synthetic
datasets (one per seed) and check whether the conclusions agree.

- **sign_agree**: same direction of effect
- **decision_agree**: same significance decision at p < 0.05
- **ci_overlap**: confidence-interval overlap (Karr et al. 2006); 1 = identical, 0 = no overlap
- **std_diff**: (synthetic − real) / real SE
- **model_choice_agree**: same best model by AIC

```{r validation-functions}
tidy_fixef <- function(fit) {
  #' Fixed effects of an lmer/glmer fit as tibble(term, estimate, se)
  tibble(term = names(fixef(fit)),
         estimate = unname(fixef(fit)),
         se = unname(sqrt(diag(as.matrix(vcov(fit))))))
}

ci_overlap <- function(est_r, se_r, est_s, se_s, level = 0.95) {
  #' Karr et al. (2006) interval overlap, averaged over both intervals; truncated at 0
  z <- qnorm(1 - (1 - level) / 2)
  lr <- est_r - z * se_r; ur <- est_r + z * se_r
  ls <- est_s - z * se_s; us <- est_s + z * se_s
  ov <- pmax(0, pmin(ur, us) - pmax(lr, ls))
  0.5 * (ov / (ur - lr) + ov / (us - ls))
}

compare_coefs <- function(real_coefs, synth_coefs) {
  #' Per-term agreement between real and synthetic estimates
  real_coefs %>%
    inner_join(synth_coefs, by = "term", suffix = c("_real", "_synth")) %>%
    mutate(
      p_real  = 2 * pnorm(-abs(estimate_real / se_real)),
      p_synth = 2 * pnorm(-abs(estimate_synth / se_synth)),
      sign_agree     = sign(estimate_real) == sign(estimate_synth),
      decision_agree = (p_real < 0.05) == (p_synth < 0.05),
      ci_overlap     = ci_overlap(estimate_real, se_real, estimate_synth, se_synth),
      std_diff       = (estimate_synth - estimate_real) / se_real
    )
}

validate_transfer <- function(real_data, analysis, model_choice = NULL, seeds = 1:10, ...) {
  #' analysis:     function(data) -> tibble(term, estimate, se)
  #' model_choice: function(data) -> name of the best candidate model (e.g. by AIC)
  #' ...:          passed to generate_synthetic_temporal_vae()
  real_coefs  <- analysis(real_data)
  real_choice <- if (!is.null(model_choice)) model_choice(real_data) else NA_character_

  per_seed <- map_dfr(set_names(seeds), function(s) {
    invisible(capture.output(
      syn <- suppressWarnings(generate_synthetic_temporal_vae(real_data, seed = s, verbose = 0, ...))
    ))
    syn <- syn %>% mutate(patient_id = as.character(patient_id))
    compare_coefs(real_coefs, analysis(syn)) %>%
      mutate(synth_choice = if (!is.null(model_choice)) model_choice(syn) else NA_character_)
  }, .id = "seed")

  summary <- per_seed %>%
    group_by(term) %>%
    summarise(
      estimate_real    = first(estimate_real),
      se_real          = first(se_real),
      estimate_synth_median = median(estimate_synth),
      sign_agree       = mean(sign_agree),
      decision_agree   = mean(decision_agree),
      ci_overlap_median = median(ci_overlap),
      std_diff_median  = median(std_diff),
      .groups = "drop"
    )

  list(
    per_seed = per_seed,
    summary = summary,
    model_choice = list(real = real_choice,
                        agreement = if (!is.null(model_choice))
                          mean(distinct(per_seed, seed, synth_choice)$synth_choice == real_choice) else NA)
  )
}
```

