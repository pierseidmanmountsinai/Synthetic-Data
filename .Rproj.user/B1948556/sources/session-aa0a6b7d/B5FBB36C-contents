## 3. Run the PART 4 models

`Model4WearablesV2_DailyMeans()` is run unchanged on the real and the synthetic data (same call as PART 4).
Each run writes its usual Excel file, plots and GOF plots to its own folder under `Corsano_Models/`.
The real fits are read from the PAR assessment if it already saved them; otherwise they are fitted here and saved.

```{r run PART 4 models, results = "hide", fig.show = "hide"}
# run the PART 4 function on one dataset, in its own folder
run_part4 <- function(d, label) {
  res_dir <- file.path(results.dir, "Corsano_Models", label)
  dir.create(res_dir, recursive = TRUE, showWarnings = FALSE)
  res <- Model4WearablesV2_DailyMeans(db = d, vars2run = key_vars, time_column = "Days_since_bio",
                                      resp_class = "resp_class_final", covs = covs,
                                      max_days = max_days, results.dir = res_dir)
  graphics.off()                                       # close devices left open if check_model() fails
  res$results %>%
    compact() %>%                                      # drop variables that failed
    set_names(map_chr(., "variable"))
}

# real: fitted once and saved
if (!file.exists(real_file)) {
  real_file <- file.path(results.dir, "Corsano_Models", "real_fits.rds")
  if (!file.exists(real_file)) saveRDS(run_part4(corsano_real, "Original"), real_file)
}
real_fits <- readRDS(real_file)

# synthetic
syn_fits <- run_part4(corsano_syn, paste0("PAR_seed_", seed_to_assess))
```


## 4. Knots, estimated means and significance calls

Per variable:

* **knots:** what BIC picks (real vs synthetic)
* **emmean_ci_overlap:** median overlap of the bi-weekly estimated-mean CIs (1 = identical)
* **between_decision_agree:** share of time points where Non-Responder vs Responder gets the same call (p < 0.05)
* **within_decision_agree:** share of class × time points where change from day 0 gets the same call

```{r compare helpers}
# share of each CI covered by the other, averaged (1 = identical CIs)
ci_overlap <- function(l1, u1, l2, u2) {
  ov <- pmax(0, pmin(u1, u2) - pmax(l1, l2))
  (ov / (u1 - l1) + ov / (u2 - l2)) / 2
}

# knots of the model BIC picked
best_knots <- function(x) {
  as.integer(gsub("knots", "", x$model_comparison$Model[which.min(x$model_comparison$BIC)]))
}
```

```{r transfer by variable}
transfer_by_var <- map_dfr(key_vars, function(v) {
  r <- real_fits[[v]]
  s <- syn_fits[[v]]
  if (is.null(r) || is.null(s)) return(tibble(variable = v))   # model failed on one of them

  # bi-weekly estimated means by class
  m <- inner_join(r$results, s$results, by = c("time_var", "resp_class"), suffix = c("_r", "_s"))

  # Non-Responder - Responder contrasts
  b <- inner_join(r$between, s$between, by = c("time_var", "contrast"), suffix = c("_r", "_s"))

  # within-class change from day 0
  w <- m %>% filter(!is.na(p_within_r), !is.na(p_within_s))

  tibble(variable = v,
         knots_real = best_knots(r),
         knots_syn = best_knots(s),
         emmean_ci_overlap = median(ci_overlap(m$lower.CL_r, m$upper.CL_r, m$lower.CL_s, m$upper.CL_s)),
         between_n = nrow(b),
         between_decision_agree = if (nrow(b) > 0) mean((b$p_between_r < 0.05) == (b$p_between_s < 0.05)) else NA,
         within_decision_agree = mean((w$p_within_r < 0.05) == (w$p_within_s < 0.05)))
})
print(as.data.frame(transfer_by_var), digits = 3)
```

```{r between calls}
# Non-Responder - Responder at each time point: real vs synthetic p-values
between_compare <- map_dfr(key_vars, function(v) {
  if (is.null(real_fits[[v]]) || is.null(syn_fits[[v]])) return(tibble())
  full_join(real_fits[[v]]$between %>% select(time_var, p_real = p_between),
            syn_fits[[v]]$between %>% select(time_var, p_syn = p_between),
            by = "time_var") %>%
    mutate(variable = v, .before = 1,
           same_decision = (p_real < 0.05) == (p_syn < 0.05))
})
print(as.data.frame(between_compare), digits = 3)
```


## 5. Covariate effects

```{r covariate effects}
# covariate coefficients (age, sex, BMI, steroid), real vs synthetic, per variable
cov_terms <- function(x) {
  tibble(term = names(fixef(x$model)),
         est = unname(fixef(x$model)),
         se = unname(sqrt(diag(vcov(x$model))))) %>%
    filter(!grepl("resp_class|time_var|Intercept", term))   # covariates only
}

covariate_compare <- map_dfr(key_vars, function(v) {
  if (is.null(real_fits[[v]]) || is.null(syn_fits[[v]])) return(tibble())
  inner_join(cov_terms(real_fits[[v]]), cov_terms(syn_fits[[v]]), by = "term", suffix = c("_real", "_syn")) %>%
    mutate(variable = v,
           p_real = 2 * pnorm(-abs(est_real / se_real)),
           p_syn  = 2 * pnorm(-abs(est_syn / se_syn)),
           same_sign = sign(est_real) == sign(est_syn),
           same_decision = (p_real < 0.05) == (p_syn < 0.05),
           ci_overlap = ci_overlap(est_real - 1.96 * se_real, est_real + 1.96 * se_real,
                                   est_syn - 1.96 * se_syn,   est_syn + 1.96 * se_syn))
})
print(as.data.frame(covariate_compare %>% select(variable, term, est_real, est_syn, p_real, p_syn,
                                                 same_sign, same_decision, ci_overlap)), digits = 3)

write_csv(covariate_compare, file.path(results.dir, "covariate_compare.csv"))
```


## 6. Plot: estimated means

Bi-weekly estimated means with 95% CIs from the PART 4 models; rows = variable, columns = response class.

```{r means plot, fig.width = 10, fig.height = 16}
# real and synthetic estimated means stacked, one row per source
means_plot_data <- map_dfr(key_vars, function(v) {
  bind_rows(Real = real_fits[[v]]$results, Synthetic = syn_fits[[v]]$results, .id = "source") %>%
    mutate(variable = gsub("hrvAnalysis_|_daily", "", v))   # short names for the panels
})

p_means <- ggplot(means_plot_data, aes(x = time_var, y = emmean, colour = source)) +
  geom_line(position = position_dodge(5)) +
  geom_point(size = 1.8, position = position_dodge(5)) +
  geom_errorbar(aes(ymin = lower.CL, ymax = upper.CL), width = 0, position = position_dodge(5)) +
  facet_grid(variable ~ resp_class, scales = "free_y") +
  scale_x_continuous(breaks = seq(0, max_days, by = 14)) +
  scale_colour_manual(values = c("Real" = "black", "Synthetic" = "darkorange")) +
  xlab("Days Since Biologic Start") +
  ylab("Estimated mean (95% CI)") +
  labs(colour = NULL) +
  theme_minimal() +
  theme(legend.position = "bottom")
p_means

ggsave(file.path(results.dir, "means_real_vs_PAR.png"), p_means, width = 10, height = 16)
```


## 7. Plot: covariate effects

```{r covariate plot, fig.width = 12, fig.height = 8}
# real and synthetic coefficients stacked, one row per source
cov_plot_data <- bind_rows(
  Real = covariate_compare %>% select(variable, term, est = est_real, se = se_real),
  Synthetic = covariate_compare %>% select(variable, term, est = est_syn, se = se_syn),
  .id = "source") %>%
  mutate(variable = gsub("hrvAnalysis_|_daily", "", variable))

p_cov <- ggplot(cov_plot_data, aes(x = est, y = term, colour = source)) +
  geom_vline(xintercept = 0, linetype = "dashed", colour = "grey60") +
  geom_point(position = position_dodge(0.5)) +
  geom_errorbarh(aes(xmin = est - 1.96 * se, xmax = est + 1.96 * se), height = 0, position = position_dodge(0.5)) +
  facet_wrap(~ variable, scales = "free_x") +
  scale_colour_manual(values = c("Real" = "black", "Synthetic" = "darkorange")) +
  xlab("Coefficient (95% CI)") +
  ylab(NULL) +
  labs(colour = NULL) +
  theme_minimal() +
  theme(legend.position = "bottom")
p_cov

ggsave(file.path(results.dir, "covariates_real_vs_PAR.png"), p_cov, width = 12, height = 8)
