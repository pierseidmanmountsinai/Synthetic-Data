## 3. Utility — patient level (longitudinal structure)

```{r patient-summary, message = FALSE, warning = FALSE}
patient_summary <- function(d) {
  slope <- function(y, x) { ok <- !is.na(y); if (sum(ok) < 3) NA_real_ else unname(coef(lm(y[ok] ~ x[ok]))[2]) }
  d %>%
    group_by(participant_id) %>%
    summarise(
      n_days = n(), last_day = max(Days_since_bio),
      across(all_of(key_vars), list(mean = ~ mean(.x, na.rm = TRUE), sd = ~ sd(.x, na.rm = TRUE),
                                    slope = ~ slope(.x, Days_since_bio))),
      resp_class_final = first(resp_class_final), sex_birth = first(sex_birth),
      age_at_enrollment = first(age_at_enrollment), bmi = first(bmi),
      .groups = "drop"
    ) %>%
    select(-participant_id) %>%
    mutate(across(where(is.numeric), ~ replace(.x, is.nan(.x), NA)), sex_birth = factor(sex_birth)) %>%
    as.data.frame()
}
real_pat <- patient_summary(real)
vae_pat  <- map(synthetic_list, patient_summary)

patient_level_overall <- ug_per_seed(vae_pat, real_pat) %>%
  summarise(pMSE = mean(pMSE), S_pMSE_mean = mean(S_pMSE), S_pMSE_min = min(S_pMSE), S_pMSE_max = max(S_pMSE))
patient_level_overall

pat_vars <- c("n_days", "last_day", paste0(rep(key_vars, each = 3), c("_mean", "_sd", "_slope")))
patient_level_by_var <- map_dfr(set_names(pat_vars), function(v) {
  s_vals <- map_dbl(vae_pat, ~ utility.tab(.x, real_pat, vars = v, ngroups = 5, print.flag = FALSE)$S_pMSE)
  tibble(S_pMSE_mean = mean(s_vals))
}, .id = "variable")
patient_level_by_var
```

## 4. Corsano daily models — `Model4WearablesV2_DailyMeans()` (PART 4)

Same call as PART 4 (`resp_class_final`, `Days_since_bio`, `max_days = 98`, PART 4 covariates).
Each dataset gets its own results folder under `Synthetic_Assessment/Corsano_Models/`.

```{r run-models, results = "hide", message = FALSE, warning = FALSE, fig.show = "hide"}
run_part4 <- function(d, label) {
  res_dir <- file.path(out_dir, "Corsano_Models", label)
  dir.create(res_dir, recursive = TRUE, showWarnings = FALSE)
  res <- Model4WearablesV2_DailyMeans(db = d, vars2run = key_vars, time_column = "Days_since_bio",
                                      resp_class = "resp_class_final", covs = covs,
                                      max_days = max_days, results.dir = res_dir)
  graphics.off()                                   # close any devices left open by the GOF step (png() not closed if check_model() fails)
  res$results %>% compact() %>% set_names(map_chr(., "variable"))
}
real_fits <- run_part4(real, "Original")
syn_fits  <- imap(synthetic_list, ~ run_part4(.x, paste0("Synthetic_", .y)))
boot_fits <- imap(boot_list, ~ run_part4(.x, paste0("Bootstrap_", .y)))
saveRDS(list(real = real_fits, synthetic = syn_fits, bootstrap = boot_fits),
        file.path(out_dir, "corsano_model_results.rds"))
```

