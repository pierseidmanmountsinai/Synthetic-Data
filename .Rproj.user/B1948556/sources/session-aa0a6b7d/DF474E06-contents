## Comparison helpers

```{r helpers}
ci_overlap <- function(est_r, se_r, est_s, se_s, level = 0.95) {
  #' Karr et al. (2006) interval overlap, averaged over both intervals; truncated at 0
  z <- qnorm(1 - (1 - level) / 2)
  lr <- est_r - z * se_r; ur <- est_r + z * se_r
  ls <- est_s - z * se_s; us <- est_s + z * se_s
  ov <- pmax(0, pmin(ur, us) - pmax(lr, ls))
  0.5 * (ov / (ur - lr) + ov / (us - ls))
}

compare_coefs <- function(real_coefs, synth_coefs) {
  #' Per-term agreement between real and synthetic estimates (tibbles of term, estimate, se)
  real_coefs %>%
    inner_join(synth_coefs, by = "term", suffix = c("_real", "_synth")) %>%
    mutate(p_real  = 2 * pnorm(-abs(estimate_real / se_real)),
           p_synth = 2 * pnorm(-abs(estimate_synth / se_synth)),
           sign_agree     = sign(estimate_real) == sign(estimate_synth),
           decision_agree = (p_real < 0.05) == (p_synth < 0.05),
           ci_overlap     = ci_overlap(estimate_real, se_real, estimate_synth, se_synth))
}

ug_per_seed <- function(syn_list, real_df) {
  #' utility.gen() per dataset (synthpop's list method fails on these data)
  map_dfr(syn_list, function(s) {
    u <- utility.gen(s, real_df, method = "cart", print.flag = FALSE)
    tibble(pMSE = u$pMSE, S_pMSE = u$S_pMSE)
  }, .id = "dataset")
}
```

## 1. Utility — patient-days

**S_pMSE** compares how well a CART model tells real from synthetic rows with what chance gives:
about 1 is ideal, below 3 good, below 10 acceptable (Raab et al.). Benchmark: synthpop `syn()` on the
same rows (cross-sectional: it ignores which patient a row belongs to).

```{r benchmark, message = FALSE, warning = FALSE}
# syn() fails on these NA columns in remove.lindep(), so NA is coded as -999 and declared with cont.na
na_vars <- key_vars[map_lgl(key_vars, ~ anyNA(real[[.x]]))]
bench_input <- real %>%
  select(-participant_id) %>%
  mutate(sex_birth = factor(sex_birth), on_any_steroid = factor(on_any_steroid),
         across(all_of(na_vars), ~ replace(.x, is.na(.x), -999))) %>%
  as.data.frame()
syn_bench <- syn(bench_input, m = length(seeds), seed = 1, print.flag = FALSE,
                 cont.na = set_names(rep(list(-999), length(na_vars)), na_vars))
bench_list <- map(syn_bench$syn, ~ .x %>%
  mutate(across(all_of(na_vars), ~ replace(.x, .x == -999, NA)),
         sex_birth = as.character(sex_birth), on_any_steroid = as.numeric(as.character(on_any_steroid))))
```

```{r utility-rows, message = FALSE, warning = FALSE}
row_vars <- c("Days_since_bio", key_vars, covs, "resp_class_final")
prep_rows <- function(d) as.data.frame(d[row_vars]) %>%     # synthpop needs data.frames with factors
  mutate(sex_birth = factor(sex_birth), on_any_steroid = factor(on_any_steroid))
vae_rows   <- map(synthetic_list, prep_rows)
bench_rows <- map(bench_list, prep_rows)
real_rows  <- prep_rows(real)

utility_per_dataset <- bind_rows(`Temporal VAE` = ug_per_seed(vae_rows, real_rows),
                                 `synthpop syn()` = ug_per_seed(bench_rows, real_rows), .id = "method")
utility_overall <- utility_per_dataset %>%
  group_by(method) %>%
  summarise(pMSE = mean(pMSE), S_pMSE_mean = mean(S_pMSE), S_pMSE_min = min(S_pMSE), S_pMSE_max = max(S_pMSE),
            .groups = "drop")
utility_overall
```

Two variants separate the daily data from the patient-level traits (age, BMI, sex, class repeat on every
row of a patient; the VAE's jittered age and BMI make synthetic patients easy to spot):

- **Daily variables only:** `Days_since_bio`, the 7 wearable variables and `on_any_steroid`.
- **Traits rounded:** all variables, with synthetic age rounded to whole years and BMI to 1 decimal, as recorded
  in the original data (DATA CHANGE for this check only).

```{r utility-rows-variants, message = FALSE, warning = FALSE}
daily_vars <- c("Days_since_bio", key_vars, "on_any_steroid")
round_traits <- function(d) d %>% mutate(age_at_enrollment = round(age_at_enrollment), bmi = round(bmi, 1))

utility_variants <- bind_rows(
  `All variables` = utility_per_dataset,
  `Daily variables only` = bind_rows(
    `Temporal VAE`   = ug_per_seed(map(vae_rows, ~ .x[daily_vars]), real_rows[daily_vars]),
    `synthpop syn()` = ug_per_seed(map(bench_rows, ~ .x[daily_vars]), real_rows[daily_vars]), .id = "method"),
  `Traits rounded` = bind_rows(
    `Temporal VAE`   = ug_per_seed(map(vae_rows, round_traits), real_rows),
    `synthpop syn()` = ug_per_seed(map(bench_rows, round_traits), real_rows), .id = "method"),
  .id = "variant"
) %>%
  group_by(variant, method) %>%
  summarise(pMSE = mean(pMSE), S_pMSE_mean = mean(S_pMSE), S_pMSE_min = min(S_pMSE), S_pMSE_max = max(S_pMSE),
