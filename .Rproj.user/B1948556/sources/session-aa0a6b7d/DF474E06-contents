```{r transfer-summary}
best_knots <- function(x) as.integer(gsub("knots", "", x$model_comparison$Model[which.min(x$model_comparison$BIC)]))
gap_nr_r <- function(x) x$results %>%                            # Non-Responder - Responder estimated mean
  select(time_var, resp_class, emmean) %>%
  pivot_wider(names_from = resp_class, values_from = emmean) %>%
  transmute(time_var, gap = Non_Responder - Responder)
cov_terms <- function(x) tibble(term = names(fixef(x$model)), estimate = unname(fixef(x$model)),
                                se = unname(sqrt(diag(vcov(x$model))))) %>%
  filter(term %in% c("age_at_enrollment", "sex_birthMale", "bmi", "on_any_steroid"))

summarise_transfer <- function(fit_list) {
  map_dfr(set_names(key_vars), function(v) {
    r <- real_fits[[v]]
    per_dataset <- map_dfr(fit_list, function(fl) {
      s <- fl[[v]]
      if (is.null(s)) return(tibble(knots = NA_real_, emmean_ci_overlap = NA_real_, gap_ratio = NA_real_,
                                    between_decision_agree = NA_real_, within_decision_agree = NA_real_))
      m <- inner_join(r$results, s$results, by = c("time_var", "resp_class"), suffix = c("_r", "_s"))
      b <- inner_join(r$between, s$between, by = c("time_var", "contrast"), suffix = c("_r", "_s"))
      g <- inner_join(gap_nr_r(r), gap_nr_r(s), by = "time_var", suffix = c("_r", "_s"))
      w <- m %>% filter(!is.na(p_within_r), !is.na(p_within_s))
      tibble(knots = best_knots(s),
             emmean_ci_overlap = median(ci_overlap(m$emmean_r, m$SE_r, m$emmean_s, m$SE_s)),
             gap_ratio = median(g$gap_s / g$gap_r),
             between_decision_agree = mean((b$p_between_r < 0.05) == (b$p_between_s < 0.05)),
             within_decision_agree = mean((w$p_within_r < 0.05) == (w$p_within_s < 0.05)))
    })
    tibble(knots_original = best_knots(r), knots = paste(per_dataset$knots, collapse = ","),
           failed_fits = sum(is.na(per_dataset$knots)),
           emmean_ci_overlap = median(per_dataset$emmean_ci_overlap, na.rm = TRUE),
           gap_ratio = median(per_dataset$gap_ratio, na.rm = TRUE),
           between_decision_agree = mean(per_dataset$between_decision_agree, na.rm = TRUE),
           within_decision_agree = mean(per_dataset$within_decision_agree, na.rm = TRUE))
  }, .id = "variable")
}
transfer_by_var <- bind_rows(synthetic = summarise_transfer(syn_fits),
                             bootstrap_ceiling = summarise_transfer(boot_fits), .id = "comparison")
transfer_by_var

covariate_transfer <- map_dfr(list(synthetic = syn_fits, bootstrap_ceiling = boot_fits), function(fl) {
  map_dfr(set_names(key_vars), function(v) {
    map_dfr(compact(map(fl, v)), ~ compare_coefs(cov_terms(real_fits[[v]]), cov_terms(.x)))
  }, .id = "variable")
}, .id = "comparison") %>%
  group_by(comparison, term) %>%
  summarise(sign_agree = mean(sign_agree), decision_agree = mean(decision_agree),
            ci_overlap_median = median(ci_overlap), .groups = "drop")
covariate_transfer
```

## 5. Original vs synthetic estimates

PART 4's own plots for every dataset are in each `Corsano_Models/<dataset>/Plots` folder.
Below: original and synthetic estimates side by side at each bi-weekly timepoint, one panel per class.

```{r sidebyside, fig.width = 13, fig.height = 5.5, message = FALSE, warning = FALSE}
side_means <- bind_rows(
  imap_dfr(real_fits, ~ .x$results %>% mutate(variable = .y, source = "Original")),
  imap_dfr(syn_fits, function(fl, nm) imap_dfr(fl, ~ .x$results %>% mutate(variable = .y, source = paste0("Synthetic ", nm))))
) %>%
  mutate(variable = gsub("hrvAnalysis_|_daily", "", variable),
         source = factor(source, levels = c("Original", paste0("Synthetic ", names(synthetic_list)))))
source_cols   <- c("Original" = "#14213D",
                   set_names(colorRampPalette(c("#E07B39", "#F2C29B"))(length(seeds)), paste0("Synthetic ", names(synthetic_list))))
source_shapes <- c("Original" = 16, set_names(rep(1, length(seeds)), paste0("Synthetic ", names(synthetic_list))))

walk(unique(side_means$variable), function(v) {
  p <- ggplot(filter(side_means, variable == v), aes(time_var, emmean, colour = source, shape = source)) +
    geom_errorbar(aes(ymin = lower.CL, ymax = upper.CL), width = 0, linewidth = 0.7, position = position_dodge(width = 10)) +
    geom_point(size = 2.4, stroke = 1, position = position_dodge(width = 10)) +
    facet_wrap(~ resp_class) +
    scale_colour_manual(values = source_cols) + scale_shape_manual(values = source_shapes) +
    scale_x_continuous(breaks = seq(0, max_days, by = 14)) +
    labs(x = "Days since biologic", y = v, colour = NULL, shape = NULL,
         title = paste0(v, ": estimated means (95% CI), original vs synthetic")) +
    theme_minimal(base_size = 14) + theme(legend.position = "bottom")
  ggsave(file.path(out_dir, paste0("sidebyside_", v, ".png")), p, width = 13, height = 5.5, dpi = 200)
  print(p)
})
```

