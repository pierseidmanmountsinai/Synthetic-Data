```{r pool and compare}
# combine synthetic estimates (synthpop rules) and compare with the real ones
pool_compare <- function(syn) {
  syn %>%
    group_by(variable, quantity, group, time_var) %>%
    summarise(m = n(),
              est_syn = mean(est),                     # q̄
              v_bar = mean(se^2),                      # average within-dataset variance
              b = if (n() > 1) var(est) else NA_real_, # between-dataset variance (for reference)
              .groups = "drop") %>%
    mutate(se_syn = sqrt(v_bar * (1 + 1 / m))) %>%     # v̄/m + v̄·k/n, k = n
    inner_join(real_est %>% rename(est_real = est, se_real = se),
               by = c("variable", "quantity", "group", "time_var")) %>%
    mutate(p_real = 2 * pnorm(-abs(est_real / se_real)),
           p_syn  = 2 * pnorm(-abs(est_syn / se_syn)),
           same_decision = if_else(quantity == "mean", NA, (p_real < 0.05) == (p_syn < 0.05)),  # means: not a test
           ci_overlap = ci_overlap(est_real - 1.96 * se_real, est_real + 1.96 * se_real,
                                   est_syn - 1.96 * se_syn,   est_syn + 1.96 * se_syn),
           z_diff = (est_syn - est_real) / sqrt(se_real^2 / m))
}

pooled_compare <- pool_compare(syn_est)                              # all m datasets
single_compare <- pool_compare(syn_est %>% filter(dataset == "1"))   # dataset 1 only, for reference

# one row per quantity: pooled vs dataset 1
compare_summary <- function(x) {
  x %>%
    group_by(quantity) %>%
    summarise(n_estimates = n(),
              median_ci_overlap = round(median(ci_overlap), 2),
              pct_same_call = round(100 * mean(same_decision, na.rm = TRUE)),
              mean_abs_z = round(mean(abs(z_diff)), 2),
              expected_abs_z = round(sqrt(2 / pi), 2),          # z_diff ~ N(0, 1) if the synthetic data are right
              .groups = "drop")
}
pooled_summary <- bind_rows(Pooled = compare_summary(pooled_compare),
                            Dataset_1 = compare_summary(single_compare),
                            .id = "synthetic")
print(as.data.frame(pooled_summary))
