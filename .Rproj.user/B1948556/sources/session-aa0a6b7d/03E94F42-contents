# estimates an analyst reports from one PART 4 model, with SEs (same emmeans calls as PART 4)
model_estimates <- function(fit, d) {
  at_days  <- list(time_var = seq(0, max_days, by = 14))                                # bi-weekly, as PART 4
  em_time  <- emmeans(fit$model, ~ time_var | resp_class, at = at_days, data = d)
  em_class <- emmeans(fit$model, ~ resp_class | time_var, at = at_days, data = d)

  # bi-weekly means by class
  means <- as.data.frame(em_time) %>%
    transmute(quantity = "mean", group = as.character(resp_class),
              time_var = as.numeric(as.character(time_var)), est = emmean, se = SE)

  # change from day 0 within class
  within <- as.data.frame(contrast(em_time, method = "trt.vs.ctrl", adjust = "none")) %>%
    transmute(quantity = "within", group = as.character(resp_class),
              time_var = as.numeric(gsub("[^0-9]", "", gsub(" - .*", "", contrast))), est = estimate, se = SE)

  # Non-Responder - Responder at each time
  between <- as.data.frame(contrast(em_class, method = "pairwise", adjust = "none")) %>%
    filter(contrast == "Non_Responder - Responder") %>%
    transmute(quantity = "between", group = as.character(contrast),
              time_var = as.numeric(as.character(time_var)), est = estimate, se = SE)

  # covariates (cov_terms() from section 9)
  covariates <- cov_terms(fit) %>%
    transmute(quantity = "covariate", group = term, time_var = NA_real_, est, se)

  bind_rows(means, within, between, covariates)
}

# all variables of one dataset
all_estimates <- function(fits, db) {
  map_dfr(names(fits), function(v) {
    tryCatch(model_estimates(fits[[v]], model_data(db, v)), error = function(e) tibble()) %>%
      mutate(variable = v, .before = 1)
  })
}

real_est <- all_estimates(real_fits, corsano_real %>% mutate(participant_id = as.character(participant_id)))
syn_est  <- map2_dfr(syn_fits_list, corsano_syn_list, all_estimates, .id = "dataset")
