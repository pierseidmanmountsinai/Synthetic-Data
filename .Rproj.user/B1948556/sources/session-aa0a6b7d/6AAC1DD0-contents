```{r transfer-summary}
transfer_by_var <- map_dfr(set_names(key_vars), function(v) {
  r <- real_fits[[v]]
  per_seed <- map_dfr(syn_fits, function(sf) {
    s <- sf[[v]]
    if (is.null(s)) return(tibble(knots_synth = NA_real_, emmean_ci_overlap = NA_real_,   # model failed on this seed
                                  between_decision_agree = NA_real_, within_decision_agree = NA_real_))
    m <- inner_join(r$means, s$means, by = c("time_var", "resp_class"), suffix = c("_r", "_s"))
    b <- inner_join(r$between, s$between, by = "time_var", suffix = c("_r", "_s"))
    w <- inner_join(r$within, s$within, by = c("resp_class", "time_var"), suffix = c("_r", "_s"))
    tibble(
      knots_synth = s$best_knots,
      emmean_ci_overlap = median(ci_overlap(m$emmean_r, m$SE_r, m$emmean_s, m$SE_s)),
      between_decision_agree = mean((b$p_between_r < 0.05) == (b$p_between_s < 0.05)),
      within_decision_agree  = mean((w$p_within_r < 0.05) == (w$p_within_s < 0.05))
    )
  })
  tibble(knots_real = r$best_knots,
         knots_synth = paste(per_seed$knots_synth, collapse = ","),
         failed_fits = sum(is.na(per_seed$knots_synth)),
         emmean_ci_overlap = median(per_seed$emmean_ci_overlap, na.rm = TRUE),
         between_decision_agree = mean(per_seed$between_decision_agree, na.rm = TRUE),
         within_decision_agree = mean(per_seed$within_decision_agree, na.rm = TRUE))
}, .id = "variable")
transfer_by_var

covariate_transfer <- map_dfr(set_names(key_vars), function(v) {
  map_dfr(compact(map(syn_fits, v)), ~ compare_coefs(real_fits[[v]]$cov_terms, .x$cov_terms))
}, .id = "variable") %>%
  group_by(term) %>%
  summarise(sign_agree = mean(sign_agree), decision_agree = mean(decision_agree),
            ci_overlap_median = median(ci_overlap), .groups = "drop")
covariate_transfer
