## 3. Utility — patient level (longitudinal structure)

Per patient: number of days, last day, and per variable the mean, SD and slope over `Days_since_bio`.

```{r patient-summary, message = FALSE, warning = FALSE}
patient_summary <- function(d) {
  slope <- function(y, x) { ok <- !is.na(y); if (sum(ok) < 3) NA_real_ else unname(coef(lm(y[ok] ~ x[ok]))[2]) }
  d %>%
    group_by(participant_id) %>%
    summarise(
      n_days = n(), last_day = max(Days_since_bio),
      across(all_of(key_vars), list(mean = ~ mean(.x, na.rm = TRUE), sd = ~ sd(.x, na.rm = TRUE),
                                    slope = ~ slope(.x, Days_since_bio))),
      resp_class_final = first(resp_class_final), sex_birth = first(sex_birth),
      age_at_enrollment = first(age_at_enrollment), bmi = first(bmi),
      .groups = "drop"
    ) %>%
    select(-participant_id) %>%
    mutate(across(where(is.numeric), ~ replace(.x, is.nan(.x), NA)),
           sex_birth = factor(sex_birth)) %>%
    as.data.frame()                                              # synthpop needs data.frame
}
real_pat <- patient_summary(real)
vae_pat  <- map(vae_list, patient_summary)

patient_level_overall <- ug_per_seed(vae_pat, real_pat) %>%
  summarise(pMSE = mean(pMSE), S_pMSE_mean = mean(S_pMSE), S_pMSE_min = min(S_pMSE), S_pMSE_max = max(S_pMSE))
patient_level_overall

pat_vars <- c("n_days", "last_day", paste0(rep(key_vars, each = 3), c("_mean", "_sd", "_slope")))
patient_level_by_var <- map_dfr(set_names(pat_vars), function(v) {
  s_vals <- map_dbl(vae_pat, ~ utility.tab(.x, real_pat, vars = v, ngroups = 5, print.flag = FALSE)$S_pMSE)
  tibble(S_pMSE_mean = mean(s_vals))
}, .id = "variable")
patient_level_by_var
```

## 4. Transfer test — PART 4 daily spline model

Same model as `Model4WearablesV2_DailyMeans`: `lme(y ~ resp_class * ns(time, df = k + 1) + covariates,
random = ~ time | participant_id, method = "ML")`, k = 0…8 knots, best by BIC; emmeans every 14 days;
within-class change vs day 0 (`trt.vs.ctrl`); Non-Responder − Responder contrast; no p-value adjustment.

```{r daily-model}
fit_daily_model <- function(d, var) {
  dd <- d %>%
    rename(time_var = Days_since_bio) %>%
    mutate(y = as.numeric(.data[[var]]), resp_class = factor(resp_class_final)) %>%
    filter(!is.na(y)) %>%
    select(participant_id, y, time_var, resp_class, all_of(covs))
  cov_rhs <- paste0(" + ", paste(covs, collapse = " + "))
  fits <- map(0:8, function(k) {
    time_term <- if (k == 0) "time_var" else paste0("ns(time_var, df = ", k + 1, ")")
    fm <- as.formula(paste0("y ~ resp_class * ", time_term, cov_rhs))
    tryCatch(lme(fixed = fm, random = ~ time_var | participant_id, data = dd, na.action = na.omit, method = "ML"),
             error = function(e) NULL)
  })
  bic <- map_dbl(fits, ~ if (is.null(.x)) Inf else BIC(.x))
  if (all(is.infinite(bic))) return(NULL)                         # every knot model failed (PART 4 also returns NULL)
  f <- fits[[which.min(bic)]]
  seq_intervals <- seq(0, max_days, by = 14)
  em <- emmeans(f, ~ time_var | resp_class, at = list(time_var = seq_intervals), data = dd)
  means <- as.data.frame(em) %>% mutate(time_var = as.numeric(as.character(time_var)))
  within <- contrast(em, method = "trt.vs.ctrl", adjust = "none") %>% as.data.frame() %>%
    mutate(time_var = as.numeric(gsub("[^0-9]", "", gsub(" - .*", "", contrast)))) %>%
    select(resp_class, time_var, p_within = p.value)
  between <- emmeans(f, pairwise ~ resp_class | time_var, at = list(time_var = seq_intervals),
                     adjust = "none", data = dd)$contrasts %>% as.data.frame() %>%
    filter(contrast == "Non_Responder - Responder") %>%
    mutate(time_var = as.numeric(as.character(time_var))) %>%
    select(time_var, estimate, SE, p_between = p.value)
  cov_terms <- tidy_fixef_lme(f) %>% filter(term %in% c("age_at_enrollment", "sex_birthMale", "bmi", "on_any_steroid"))
  list(best_knots = which.min(bic) - 1, means = means, within = within, between = between, cov_terms = cov_terms)
}

tidy_fixef_lme <- function(f) {
  tibble(term = names(fixef(f)), estimate = unname(fixef(f)), se = unname(sqrt(diag(vcov(f)))))
}
```

```{r run-models, message = FALSE, warning = FALSE}
