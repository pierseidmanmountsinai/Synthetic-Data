## Generate synthetic data (VAE) and the synthpop benchmark

```{r generate, results = "hide", message = FALSE, warning = FALSE}
vae_list <- map(seeds, function(s) {
  generate_synthetic_temporal_vae(for_generator, seed = s, verbose = 0,
                                  time_var = "Days_since_bio", cond_vars = cond_vars) %>%
    back_to_original()
})

# Benchmark: synthpop CART synthesis of patient-day rows (cross-sectional: ignores who the rows belong to)
# syn() fails on these NA columns in remove.lindep(), so NA is coded as -999 and declared with cont.na
na_vars <- key_vars[map_lgl(key_vars, ~ anyNA(real[[.x]]))]
bench_input <- real %>%
  select(-participant_id) %>%
  mutate(sex_birth = factor(sex_birth), on_any_steroid = factor(on_any_steroid),
         across(all_of(na_vars), ~ replace(.x, is.na(.x), -999))) %>%
  as.data.frame()
syn_bench <- syn(bench_input, m = length(seeds), seed = 1, print.flag = FALSE,
                 cont.na = set_names(rep(list(-999), length(na_vars)), na_vars))
bench_list <- map(syn_bench$syn, ~ .x %>%
  mutate(across(all_of(na_vars), ~ replace(.x, .x == -999, NA)),
         sex_birth = as.character(sex_birth), on_any_steroid = as.numeric(as.character(on_any_steroid))))

saveRDS(list(vae = vae_list, synthpop = bench_list), file.path(out_dir, "synthetic_datasets.rds"))
```

