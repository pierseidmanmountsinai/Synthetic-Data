## 9. Model transfer

The question that matters: would an analyst reach the same conclusions from the synthetic data?
Model: `log(bili) ~ trt * time + age + sex`, random intercept and slope per patient, time as linear (0 knots)
or natural spline (1-4 knots), knots chosen by BIC (same approach as PART 4 of the JJ project).

```{r bili model}
knots_seq <- 0:4

# bilirubin model with k knots (k = 0 -> linear time)
# CHANGED: lab argument added (default bili) so the same model is reused for alk.phos in 9b
bili_model <- function(db, k, lab = "bili") {
  time_term <- if (k == 0) "t" else paste0("ns(t, df = ", k + 1, ")")
  fm <- as.formula(paste0("log(", lab, ") ~ trt * ", time_term, " + age + sex"))
  tryCatch(lme(fm, random = ~ t | patient_id, data = db, na.action = na.omit, method = "ML",
               control = lmeControl(opt = "optim")),
           error = function(e) NULL)   # failed fit -> NULL
}
```

```{r knots by BIC}
# BIC for each knot count, real and synthetic
bic_table <- map_dfr(knots_seq, function(k) {
  f_r <- bili_model(pbc_real, k)
  f_s <- bili_model(pbc_syn, k)
  tibble(knots = k,
         BIC_real = if (is.null(f_r)) NA else BIC(f_r),
         BIC_syn  = if (is.null(f_s)) NA else BIC(f_s))
}) %>%
  mutate(Delta_BIC_real = BIC_real - min(BIC_real, na.rm = TRUE),
         Delta_BIC_syn  = BIC_syn  - min(BIC_syn,  na.rm = TRUE))
print(bic_table)

best_knots_real <- bic_table$knots[which.min(bic_table$BIC_real)]
best_knots_syn  <- bic_table$knots[which.min(bic_table$BIC_syn)]
cat("Best knots (BIC): real =", best_knots_real, "; synthetic =", best_knots_syn, "\n")
```

```{r coefficients}
# same model (real's knots) on both
f_real <- bili_model(pbc_real, best_knots_real)
f_syn  <- bili_model(pbc_syn,  best_knots_real)

# estimate, 95% CI and p-value of each coefficient
coef_table <- function(f) {
  s <- summary(f)$tTable
  tibble(term = rownames(s),
         est = s[, "Value"],
         lo  = s[, "Value"] - 1.96 * s[, "Std.Error"],
         hi  = s[, "Value"] + 1.96 * s[, "Std.Error"],
         p   = s[, "p-value"])
}

# share of each CI covered by the other, averaged (1 = identical CIs)
ci_overlap <- function(l1, u1, l2, u2) {
  ov <- pmax(0, pmin(u1, u2) - pmax(l1, l2))
  (ov / (u1 - l1) + ov / (u2 - l2)) / 2
}

coef_compare <- inner_join(coef_table(f_real), coef_table(f_syn),
                           by = "term", suffix = c("_real", "_syn")) %>%
  mutate(same_sign = sign(est_real) == sign(est_syn),
         same_decision = (p_real < 0.05) == (p_syn < 0.05),   # significant in both or neither
         ci_overlap = ci_overlap(lo_real, hi_real, lo_syn, hi_syn))
print(as.data.frame(coef_compare), digits = 3)
```

