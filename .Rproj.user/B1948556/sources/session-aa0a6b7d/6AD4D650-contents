## 1. Real data

Mayo PBC trial: 312 patients, labs at irregular visits, two treatment arms (`trt`: D-penicillamine vs placebo).

```{r load data}
# DATA CHANGES: time = half-years since entry (rounded); codes made factors; the event / derived columns are dropped;
# two visits in the same half-year are combined into one (labs averaged, categories from the later visit)
pbc_real <- pbcseq %>%
  transmute(patient_id = id,
            t = round(day / 182.625),            # days -> half-years
            trt = factor(trt),
            sex = factor(sex),
            age,
            bili, albumin, alk.phos, ast, platelet, protime, chol,
            ascites = factor(ascites),
            hepato  = factor(hepato),
            spiders = factor(spiders),
            edema   = factor(edema))
n_before <- nrow(pbc_real)

# ---- Two visits in the same half-year -> one row ----
pbc_real <- pbc_real %>%
  group_by(patient_id, t) %>%
  summarise(across(c(trt, sex, age), first),                                                        # traits: same in both
            across(c(bili, albumin, alk.phos, ast, platelet, protime, chol), ~ mean(.x, na.rm = TRUE)),  # labs: average
            across(c(ascites, hepato, spiders, edema), ~ last(na.omit(.x))),                         # categories: later visit
            .groups = "drop") %>%
  mutate(across(c(bili, albumin, alk.phos, ast, platelet, protime, chol),
                ~ replace(.x, is.nan(.x), NA)))                                                    # both missing -> NA
cat("DATA CHANGE:", n_before - nrow(pbc_real), "pairs of visits in the same half-year combined into one\n")

# variable groups used below
traits <- c("trt", "sex", "age")
labs   <- c("bili", "albumin", "alk.phos", "ast", "platelet", "protime", "chol")
cats   <- c("ascites", "hepato", "spiders", "edema")
```


