## 8. Within-patient structure

For each lab: `lme(log(lab) ~ t, random = ~ t | patient_id)` on real and synthetic data.
sd_intercept / sd_slope = how much patients differ in level / in change over time; sd_resid = visit-to-visit noise;
lag1_cor = correlation of a patient's residuals at consecutive visits.

```{r variance components}
# var components for one lab
var_components <- function(db, var) {
  d <- db %>%
    mutate(y = log(.data[[var]])) %>%   # take log
    filter(!is.na(y)) %>%
    arrange(patient_id, t)

  # random intercept + slope model
  f <- tryCatch(lme(y ~ t, random = ~ t | patient_id, data = d, method = "ML",
                    control = lmeControl(opt = "optim")),
                error = function(e) NULL)
  if (is.null(f)) return(tibble(variable = var))

  sds <- as.numeric(VarCorr(f)[, "StdDev"])   # sd as numeric: intercept, slope, residual

  # residual and the same patient's residual at the previous visit
  r <- d %>%
    mutate(e = resid(f)) %>%
    group_by(patient_id) %>%
    mutate(e_prev = lag(e)) %>%
    ungroup()

  tibble(variable = var,
         sd_intercept = sds[1],
         sd_slope = sds[2],
         sd_resid = sds[3],
         lag1_cor = cor(r$e, r$e_prev, use = "complete.obs"))
}

# all labs, real and synthetic
vc_table <- map_dfr(labs, function(v) {
  bind_rows(Real = var_components(pbc_real, v),
            Synthetic = var_components(pbc_syn, v),
            .id = "source")
})
print(as.data.frame(vc_table), digits = 3)
```

