## Test Run (NEW)

Test data: `nlme::Orthodont` (27 patients × 4 timepoints).
Recoded: `Subject` → `patient_id`, `age` (8/10/12/14) → `time` (1–4).
`age` is dropped because it is now `time`. Variables kept: `distance` (continuous), `Sex` (categorical).

```{r test-data}
test_data <- as_tibble(Orthodont) %>%
  mutate(
    patient_id = as.character(Subject),
    time = as.integer((age - 8) / 2 + 1)
  ) %>%
  select(patient_id, time, distance, Sex)

head(test_data)
```

```{r test-run}
synthetic <- generate_synthetic_temporal_vae(
  real_data = test_data,
  seed = 42,
  verbose = 0  # CHANGED: epochs = 300 removed; early stopping decides (max 1000)
)

head(synthetic, 8)
dim(synthetic)
colSums(is.na(synthetic))  # check for NaN/NA from inverse Box-Cox
plot(attr(synthetic, "history"))  # training / validation loss
```

```{r test-compare}
compare <- bind_rows(
  real = test_data,
  synthetic = synthetic %>% mutate(patient_id = as.character(patient_id)),
  .id = "source"
)

# Marginal: distance
compare %>%
  group_by(source) %>%
  summarise(mean = mean(distance), sd = sd(distance),
            min = min(distance), max = max(distance))

# Marginal: Sex
compare %>% count(source, Sex) %>% group_by(source) %>% mutate(prop = n / sum(n))

# Dependence: distance by Sex
compare %>% group_by(source, Sex) %>% summarise(mean_distance = mean(distance), .groups = "drop")
```

### Longitudinal checks

```{r test-longitudinal}
# Mean distance by timepoint
compare %>%
  group_by(source, time) %>%
  summarise(mean_distance = mean(distance), .groups = "drop") %>%
  pivot_wider(names_from = time, values_from = mean_distance, names_prefix = "t")

# Slope per timepoint
compare %>%
  group_by(source) %>%
  summarise(slope = coef(lm(distance ~ time))[2])

# ICC: share of variance between patients
compare %>%
  split(.$source) %>%
  map_dfr(~ {
    v <- as.data.frame(VarCorr(lmer(distance ~ 1 + (1 | patient_id), data = .x)))$vcov
    tibble(ICC = v[1] / sum(v))
  }, .id = "source")

# Within-patient correlation between timepoints
within_cor <- function(d) {
  d %>%
    select(patient_id, time, distance) %>%
    pivot_wider(names_from = time, values_from = distance, names_prefix = "t") %>%
    select(-patient_id) %>%
    cor() %>%
    round(2)
}
within_cor(test_data)
within_cor(synthetic)

# Proportion of patients whose Sex is constant across timepoints
compare %>%
  group_by(source, patient_id) %>%
  summarise(constant = n_distinct(Sex) == 1, .groups = "drop") %>%
  group_by(source) %>%
  summarise(prop_constant = mean(constant))
```

### Multi-seed evaluation (NEW)

One run is noisy with 27 patients, so the model is trained and sampled with
10 different seeds. The table shows the median and range across runs next to the real data.

```{r test-multiseed, results = "hide", message = FALSE, warning = FALSE}
seed_metrics <- function(d) {
  d <- d %>% mutate(patient_id = as.character(patient_id))
  wc <- within_cor(d)
  v <- as.data.frame(VarCorr(lmer(distance ~ 1 + (1 | patient_id), data = d)))$vcov
  tibble(
    sd_distance = sd(d$distance),
    male_minus_female = mean(d$distance[d$Sex == "Male"]) - mean(d$distance[d$Sex == "Female"]),
    slope = coef(lm(distance ~ time, data = d))[[2]],
    within_patient_cor = mean(wc[upper.tri(wc)]),
    icc = v[1] / sum(v),
    prop_male = mean(d$Sex == "Male")
  )
}

seed_runs <- map_dfr(set_names(1:10), function(s) {
  syn <- generate_synthetic_temporal_vae(test_data, seed = s, verbose = 0)
  seed_metrics(syn) %>% mutate(epochs_run = length(attr(syn, "history")$metrics$loss))
}, .id = "seed")
```

```{r test-multiseed-summary}
seed_runs

seed_runs %>%
  select(-seed) %>%
  pivot_longer(everything(), names_to = "metric") %>%
  group_by(metric) %>%
  summarise(median = median(value), min = min(value), max = max(value)) %>%
  left_join(seed_metrics(test_data) %>% pivot_longer(everything(), names_to = "metric", values_to = "real"),
            by = "metric")
```

## Simulated Data Test (NEW)

200 patients × 5 visits with **known true parameters**:
`outcome = 20 + 1.0·time + 2.0·Male + 0.5·time·groupB + 1.0·time·groupC + b0 + b1·time + e`,
with b0 ~ N(0, 2²), b1 ~ N(0, 0.5²), e ~ N(0, 1.5²).
`biomarker` is log-normal and related to the patient intercept b0. `Sex` and `group` are time-invariant.

The test fits the same mixed model to the simulated "real" data and to the synthetic data and compares
the estimates with the truth: the conclusions should transfer.

```{r sim-data}
simulate_longitudinal <- function(n_patients = 200, n_timepoints = 5, seed = 2026) {
  set.seed(seed)
  patients <- tibble(
    patient_id = sprintf("P%03d", seq_len(n_patients)),
    Sex   = factor(sample(c("Male", "Female"), n_patients, replace = TRUE), levels = c("Male", "Female")),
    group = factor(sample(c("A", "B", "C"), n_patients, replace = TRUE)),
    b0 = rnorm(n_patients, 0, 2),
    b1 = rnorm(n_patients, 0, 0.5)
  )
  patients %>%
    crossing(time = seq_len(n_timepoints)) %>%
    mutate(
      outcome = 20 + 1.0 * time + 2.0 * (Sex == "Male") +
                0.5 * time * (group == "B") + 1.0 * time * (group == "C") +
                b0 + b1 * time + rnorm(n(), 0, 1.5),
      biomarker = exp(1 + 0.15 * b0 + 0.05 * time + rnorm(n(), 0, 0.3))
    ) %>%
    select(patient_id, time, outcome, biomarker, Sex, group)
}

sim_data <- simulate_longitudinal()
head(sim_data)
```

```{r sim-run}
sim_synthetic <- generate_synthetic_temporal_vae(sim_data, seed = 1, verbose = 0)
```

```{r sim-transfer}
fit_lmm <- function(d) {
  lmer(outcome ~ time * group + Sex + (1 + time | patient_id),
       data = mutate(d, patient_id = as.character(patient_id)))
}
fit_real  <- fit_lmm(sim_data)
fit_synth <- fit_lmm(sim_synthetic)

# Fixed effects: truth vs real vs synthetic
truth <- c("(Intercept)" = 22, "time" = 1, "groupB" = 0, "groupC" = 0,
           "SexFemale" = -2, "time:groupB" = 0.5, "time:groupC" = 1)
tibble(
  term      = names(fixef(fit_real)),
  truth     = truth[names(fixef(fit_real))],
  real      = fixef(fit_real),
  real_se   = sqrt(diag(as.matrix(vcov(fit_real)))),
  synth     = fixef(fit_synth)[names(fixef(fit_real))],
  synth_se  = sqrt(diag(as.matrix(vcov(fit_synth))))[names(fixef(fit_real))]
)

# Variance components (SD; cor = intercept-slope correlation)
tibble(
  component = c("intercept SD", "slope SD", "intercept-slope cor", "residual SD"),
  truth     = c(2, 0.5, 0, 1.5),
  real      = as.data.frame(VarCorr(fit_real))$sdcor,
  synth     = as.data.frame(VarCorr(fit_synth))$sdcor
)

# Outcome-biomarker correlation
c(real = cor(sim_data$outcome, sim_data$biomarker),
  synth = cor(sim_synthetic$outcome, sim_synthetic$biomarker))
```










