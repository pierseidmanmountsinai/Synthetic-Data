## Helper Functions

```{r helpers}
auto_detect_var_types <- function(data) {
  map(data, function(x) {
    if (is.numeric(x)) "continuous"
    else if (is.character(x) || is.factor(x)) "categorical"
    else "other"
  })
}

detect_static_vars <- function(data, vars) {                     # NEW
  #' Variables with a single value within every patient
  data %>%
    group_by(patient_id) %>%
    summarise(across(all_of(vars), n_distinct), .groups = "drop") %>%
    select(-patient_id) %>%
    map_lgl(~ all(.x == 1)) %>%
    which() %>%
    names()
}

fit_boxcox_parallel_r <- function(data, var_types) {
  continuous_vars <- names(var_types[var_types == "continuous"])

  boxcox_list <- map(continuous_vars, function(var) {
    fit_boxcox_single_r(data[[var]], var)
  })

  names(boxcox_list) <- continuous_vars

  full_params <- map(names(var_types), function(var) {
    if (var %in% continuous_vars) boxcox_list[[var]]
    else list(lambda = NA, shift = 0, fitted = FALSE)
  })
  names(full_params) <- names(var_types)

  return(full_params)
}

fit_boxcox_single_r <- function(vals, var_name) {
  tryCatch({
    vals <- as.numeric(vals)
    vals <- vals[!is.na(vals)]

    if (any(vals <= 0)) {
      shift <- abs(min(vals)) + 1
      vals <- vals + shift
    } else {
      shift <- 0
    }

    pt <- car::powerTransform(vals)
    lambda <- pt$lambda

    list(lambda = lambda, shift = shift, fitted = TRUE)
  }, error = function(e) {
    cat(sprintf("  Warning: Box-Cox failed for %s\n", var_name))
    list(lambda = 1, shift = 0, fitted = FALSE)
  })
}

apply_boxcox_parallel_r <- function(data, boxcox_params, var_types) {
  continuous_vars <- names(var_types[var_types == "continuous"])

  transformed_vars <- map(continuous_vars, function(var) {
    boxcox_transform_single_r(data[[var]], boxcox_params[[var]])
  })
  names(transformed_vars) <- continuous_vars

  result <- data %>% select(-all_of(continuous_vars))

  map2(continuous_vars, transformed_vars, function(var, vals) {
    result[[var]] <<- vals
  })

  result %>% select(all_of(names(data)))
}

boxcox_transform_single_r <- function(vals, boxcox_param) {
  lambda <- boxcox_param$lambda
  shift <- boxcox_param$shift
  vals_shifted <- vals + shift

  if (abs(lambda) < 1e-6) log(vals_shifted)
  else (vals_shifted^lambda - 1) / lambda
}

fit_marginals_r <- function(data, var_types) {
  map2(names(var_types), var_types, function(var, type) {
    if (type == "continuous") {
      list(type = "continuous", mean = mean(data[[var]]), sd = sd(data[[var]]))
    } else if (type == "categorical") {
      unique_vals <- sort(unique(data[[var]]))
      list(type = "categorical", levels = unique_vals, n_levels = length(unique_vals))
    }
  }) %>%
    set_names(names(var_types))   # CHANGED: added so marginals[[var]] works
}

standardize_data_r <- function(data, marginals, var_types) {
  continuous_vars <- names(var_types[var_types == "continuous"])
  data %>%                                                       # CHANGED: across() instead of for loop
    mutate(across(all_of(continuous_vars),
                  ~ (.x - marginals[[cur_column()]]$mean) / marginals[[cur_column()]]$sd))
}

encode_features <- function(data, marginals, var_types) {        # NEW
  #' Continuous columns as-is; categorical columns one-hot (named var__level)
  continuous_vars  <- names(var_types[var_types == "continuous"])
  categorical_vars <- names(var_types[var_types == "categorical"])

  cont_block <- as.matrix(data[continuous_vars])
  cat_blocks <- map(categorical_vars, function(var) {
    lv <- marginals[[var]]$levels
    m <- outer(as.character(data[[var]]), as.character(lv), "==") * 1
    colnames(m) <- paste0(var, "__", lv)
    m
  })

  mat <- do.call(cbind, c(list(cont_block), cat_blocks))
  storage.mode(mat) <- "double"

  list(
    matrix = mat,
    continuous_vars = continuous_vars,
    categorical_vars = categorical_vars,
    cat_sizes = map_int(categorical_vars, ~ marginals[[.x]]$n_levels)
  )
}

reshape_to_sequences <- function(mat, n_patients, n_timepoints) {  # CHANGED: no for loop
  #' Rows ordered patient-major, time-minor -> array [patient, time, feature]
  aperm(array(mat, dim = c(n_timepoints, n_patients, ncol(mat))), c(2, 1, 3))
}

sequences_to_matrix <- function(arr) {                           # NEW
  #' Array [patient, time, feature] -> rows ordered patient-major, time-minor
  matrix(aperm(arr, c(2, 1, 3)), ncol = dim(arr)[3])
}

sample_categories <- function(p) {                               # NEW
  #' Draw one category index per row from a matrix of probabilities
  p <- p / rowSums(p)
  k <- ncol(p)
  cum <- p %*% upper.tri(diag(k), diag = TRUE)   # row-wise cumulative sums
  pmin(rowSums(runif(nrow(p)) > cum) + 1, k)
}

estimate_residual_sd <- function(vae_model, X_train, encoded, C_train = NULL) {  # NEW
  #' Reconstruct the real sequences from z_mean (no sampling noise) and return
  #' the SD of the reconstruction residuals for each continuous variable
  decoder <- get_layer(vae_model, "decoder")
  z_mean_out <- get_layer(vae_model, "z_mean")$output
  if (is.null(C_train)) {
    mean_model <- keras_model(vae_model$input, decoder(z_mean_out))
    recon <- mean_model %>% predict(X_train, verbose = 0)
  } else {                                                       # NEW: conditional version
    mean_model <- keras_model(vae_model$inputs, decoder(list(z_mean_out, vae_model$inputs[[2]])))
    recon <- mean_model %>% predict(list(X_train, C_train), verbose = 0)
  }
  resid <- sequences_to_matrix(X_train) - sequences_to_matrix(recon)
  colnames(resid) <- colnames(encoded$matrix)
  map_dbl(set_names(encoded$continuous_vars), ~ sd(resid[, .x]))
}

decode_features <- function(mat, encoded, marginals, static_vars, n_timepoints,
                            resid_sd = NULL) {  # NEW (resid_sd: CHANGED, added)
  #' Decoder output -> tibble on the standardized Box-Cox scale (categorical as levels).
  #' Time-invariant variables: one value per patient (continuous: mean over
  #' timepoints; categorical: one draw from the probabilities averaged over timepoints).
  #' resid_sd: if given, Gaussian noise with this SD is added to continuous variables
  #' (per visit; once per patient for time-invariant ones).
  pid <- rep(seq_len(nrow(mat) / n_timepoints), each = n_timepoints)

  cont <- map(set_names(encoded$continuous_vars), function(var) {
    v <- mat[, var]
    sd_noise <- if (is.null(resid_sd)) 0 else resid_sd[[var]]       # NEW
    if (var %in% static_vars) {
      ave(v, pid) + rnorm(max(pid), 0, sd_noise)[pid]               # CHANGED: + noise once per patient
    } else {
      v + rnorm(length(v), 0, sd_noise)                             # CHANGED: + noise per visit
    }
  })

  cats <- map(set_names(encoded$categorical_vars), function(var) {
    lv <- marginals[[var]]$levels
    p <- mat[, paste0(var, "__", lv), drop = FALSE]
    idx <- if (var %in% static_vars) {
      sample_categories(rowsum(p, pid) / n_timepoints)[pid]
    } else {
      sample_categories(p)
    }
    lv[idx]
  })

  as_tibble(c(cont, cats))
}

inverse_standardize_data_r <- function(data, marginals, var_types) {
  continuous_vars <- names(var_types[var_types == "continuous"])
  data %>%                                                       # CHANGED: across() instead of for loop
    mutate(across(all_of(continuous_vars),
                  ~ .x * marginals[[cur_column()]]$sd + marginals[[cur_column()]]$mean))
}

inverse_boxcox_parallel_r <- function(data, boxcox_params, var_types) {
  continuous_vars <- names(var_types[var_types == "continuous"])

  result <- data

  map(continuous_vars, function(var) {
    result[[var]] <<- inverse_boxcox_single_r(data[[var]], boxcox_params[[var]])
  })

  return(result)
}

inverse_boxcox_single_r <- function(y, boxcox_param) {
  lambda <- boxcox_param$lambda
  shift <- boxcox_param$shift

  if (abs(lambda) < 1e-6) {
    x <- exp(y)
  } else {
    x <- (lambda * y + 1)^(1 / lambda)
  }

  x - shift
}
