## Generator: main function

```{r generator-main}
generate_synthetic_temporal_vae <- function(
  real_data,
  n_patients = NULL,
  n_timepoints = NULL,
  var_types = NULL,
  latent_dim = 8,
  epochs = 1000,       # CHANGED: was 50; now a maximum, early stopping decides
  batch_size = 32,
  seed = 42,
  verbose = 1,
  time_var = "time",   # NEW: name of the time column (its values define the visit grid)
  kl_beta = 0.05,      # NEW: final KL weight (< 1 keeps more patient information in z)
  kl_warmup = 100,     # NEW: epochs over which the KL weight rises from 0 to kl_beta
  patience = 100,      # NEW: early stopping patience (epochs)
  m = 1                # NEW (pooling): number of synthetic datasets drawn from the one trained model
) {

  #' Generate synthetic longitudinal data via Temporal VAE
  #'
  #' @param real_data Dataframe with patient_id, the time column, and variable columns
  #' @param n_patients Number of patients to generate (default: number in real_data)
  #' @param n_timepoints Must equal the number of distinct time values in real_data
  #' @param var_types Named list of variable types (auto-detected if NULL)
  #' @param latent_dim Dimensionality of latent space (default: 8)
  #' @param epochs Maximum number of training epochs (default: 1000)
  #' @param batch_size Batch size for training (default: 32)
  #' @param seed Random seed
  #' @param verbose Keras verbosity (0=silent, 1=progress, 2=one line per epoch)
  #' @param time_var Name of the time column. Its distinct values form the visit grid; patients may have any
  #'        subset of them (unequal / irregular visits). Output uses the same column name.
  #' @param kl_beta,kl_warmup,patience Training settings (see Background in PART 1)
  #' @param m Number of synthetic datasets (default 1). The model is trained once; traits, z and draws are new
  #'        for each dataset. m > 1 returns a list of m data frames (for pooling, as synthpop's summary.fit.synds)
  #'
  #' Variables constant within every patient (and never missing) are patient traits: they are given to the
  #' encoder and decoder as conditioning, and each synthetic patient's z is drawn given its traits.
  #' Missing values are allowed: they are left out of the loss, and where values and visits are missing is
  #' learned and reproduced.
  #'
  #' @return Dataframe with synthetic data (original scale), or a list of m of them; training history in attr(, "history")

  set.seed(seed)
  set_random_seed(seed)  # CHANGED: keras3 replacement for use_session_with_seed()

  # Step 1: Order rows and build the visit grid                  # NEW (unequal / irregular visits)
  real_data <- real_data %>%
    rename(.time = all_of(time_var)) %>%
    arrange(patient_id, .time)
  if (anyNA(real_data$.time)) stop("The time column has missing values.")
  if (anyDuplicated(real_data[c("patient_id", ".time")])) stop("A patient has two rows with the same time.")
  time_grid <- sort(unique(real_data$.time))
  patient_ids       <- unique(real_data$patient_id)
  n_patients_real   <- length(patient_ids)
  n_timepoints_real <- length(time_grid)
  cat(sprintf("Visit grid: %d time points; %d patients; %.0f%% of patient-time slots observed\n",
              n_timepoints_real, n_patients_real, 100 * nrow(real_data) / (n_patients_real * n_timepoints_real)))

  # Infer defaults
  if (is.null(n_patients)) {
    n_patients <- n_patients_real
  }
  if (is.null(n_timepoints)) {
    n_timepoints <- n_timepoints_real                            # CHANGED: grid length (was max(time))
  }
  if (n_timepoints != n_timepoints_real) stop("n_timepoints must equal the number of distinct time values.")  # NEW

  # Step 1b: De-identify
  data_vars <- real_data %>% select(-patient_id, -.time)          # CHANGED: time also removed (grid position encodes it)

  # Step 2: Auto-detect variable types
  if (is.null(var_types)) {
    var_types <- auto_detect_var_types(data_vars)
    cat("Auto-detected variable types:\n")
    iwalk(var_types, ~ cat(sprintf("  %s: %s\n", .y, .x)))
  }
  vars <- names(var_types)[var_types %in% c("continuous", "categorical")]   # NEW: drop type "other"
  if (length(setdiff(names(data_vars), vars)) > 0) {
    message("DATA CHANGE: dropped variables of type 'other': ", paste(setdiff(names(data_vars), vars), collapse = ", "))
  }
  var_types <- var_types[vars]
  data_vars <- data_vars %>% select(all_of(vars))

  # Step 2b: Patient traits = variables constant within every patient and never missing   # NEW (conditioning)
  static_vars <- detect_static_vars(real_data, vars)
  cond_vars <- static_vars[!map_lgl(static_vars, ~ anyNA(data_vars[[.x]]))]
  seq_types <- var_types[setdiff(vars, cond_vars)]
  has_cond  <- length(cond_vars) > 0
  cat("Patient traits (conditioning):", if (has_cond) paste(cond_vars, collapse = ", ") else "none", "\n")

  # Step 3: Fit Box-Cox transformations
  boxcox_params <- fit_boxcox_parallel_r(data_vars, var_types)
  cat("✓ Box-Cox transformations fitted\n")

  # Step 4: Apply Box-Cox
  data_boxcox <- apply_boxcox_parallel_r(data_vars, boxcox_params, var_types)

  # Step 5: Fit marginals and standardize
  marginals <- fit_marginals_r(data_boxcox, var_types)
  data_standardized <- standardize_data_r(data_boxcox, marginals, var_types)
  value_maps <- build_value_maps(data_vars, data_standardized, var_types)   # NEW (fix 1, 2): way back to observed values

  # Step 6: Put every patient on the full grid (empty slot = no visit), encode, add masks, reshape   # CHANGED
  data_grid <- tibble(patient_id = rep(patient_ids, each = n_timepoints_real),
                      .time = rep(time_grid, n_patients_real)) %>%
    left_join(bind_cols(real_data %>% select(patient_id, .time), data_standardized, .visit = 1),
              by = c("patient_id", ".time")) %>%
    mutate(.visit = coalesce(.visit, 0))
  encoded <- encode_features(data_grid %>% select(all_of(names(seq_types))), marginals, seq_types)  # NEW: one-hot
  # Masks (NEW): the network cannot take NA, so missing values enter as 0. A 0 alone is ambiguous
  # (real value or gap?), so every value gets a 0/1 flag:
  #   observed mask (one per variable): 1 = value measured, 0 = missing (e.g. skin temp missing on 41% of JJ days)
  #   visit mask (.visit, one per time point): 1 = the patient had any data at that time point
  # Training: the loss only counts values whose observed mask is 1, so the placeholder 0s are never learned.
  # Generating: the model also predicts both masks; drawn 0s become NA (observed) or dropped rows (visit),
  # which reproduces the real gaps and wear patterns.
  obs_mask <- map(set_names(names(seq_types)),                      # NEW: 1 = value observed at a visit
                  ~ as.numeric(!is.na(data_grid[[.x]]) & data_grid$.visit == 1)) %>% as_tibble() %>% as.matrix()
  colnames(obs_mask) <- paste0(colnames(obs_mask), "__observed")
  seq_matrix <- cbind(encoded$matrix, obs_mask, .visit = data_grid$.visit)   # NEW: values | observed | visit
  seq_matrix[is.na(seq_matrix)] <- 0                                # NEW: missing values enter as 0 (masked in loss)

  X_train <- reshape_to_sequences(seq_matrix, n_patients_real, n_timepoints_real)
  cat(sprintf("✓ Data reshaped to sequences: (%d, %d, %d)\n",
              dim(X_train)[1], dim(X_train)[2], dim(X_train)[3]))

  if (has_cond) {                                                   # NEW: traits, one row per patient
    patient_cond <- data_standardized[match(patient_ids, real_data$patient_id), cond_vars]
    C_train <- encode_features(patient_cond, marginals, var_types[cond_vars])$matrix
  }
  model_x <- if (has_cond) list(X_train, C_train) else X_train    # NEW

  # Step 7: Build and train Temporal VAE
  vae_model <- build_temporal_vae(
    n_timepoints_real,
    encoded,                                                        # CHANGED: encoding info (was n_features)
    latent_dim,
    n_cond = if (has_cond) ncol(C_train) else 0,                    # NEW
    seq_vars = names(seq_types)                                     # NEW
  )

  cat("✓ Temporal VAE model built\n")

  history <- vae_model %>% fit(
    model_x, X_train,                                               # CHANGED: was X_train, X_train
    epochs = epochs,
    batch_size = batch_size,
    validation_split = 0.1,
    verbose = verbose,
    callbacks = list(                                               # NEW
      callback_kl_warmup(kl_warmup, kl_beta),                       # KL warm-up (avoids posterior collapse)
      callback_early_stopping(monitor = "val_loss", patience = patience, restore_best_weights = TRUE,
                              start_from_epoch = kl_warmup)
    )
  )

  cat(sprintf("✓ Temporal VAE trained (%d epochs run)\n", length(history$metrics$loss)))

  # Step 7b: Structure of what the model misses (per variable): patient-level intercept/slope,   # NEW (fix 3)
  # day-to-day correlation (AR(1)) and residual SD, from the reconstruction errors of the real patients
  noise <- estimate_noise_structure(vae_model, model_x, X_train, encoded, colnames(seq_matrix),
                                    static_vars, n_timepoints_real)
  cat_persistence <- estimate_cat_persistence(data_grid, encoded$categorical_vars, static_vars)  # NEW (fix 4)

  # Step 8: Draw z for each synthetic patient                       # CHANGED (was z ~ N(0, I) per time point)
  decoder <- get_layer(vae_model, "decoder")
  z_model <- keras_model(vae_model$inputs, list(get_layer(vae_model, "z_mean")$output,
                                                get_layer(vae_model, "z_log_var")$output))
  z_real   <- z_model %>% predict(model_x, verbose = 0)
  post_var <- diag(colMeans(exp(z_real[[2]])), latent_dim)
  draw_one <- function(i) {                                        # NEW (pooling): one synthetic dataset; called m times
    if (has_cond) {                                                   # CHANGED (privacy): synthetic traits; z given traits
      synthetic_cond <- synthesize_traits(data_vars[match(patient_ids, real_data$patient_id), cond_vars, drop = FALSE],
                                            var_types[cond_vars], n_patients, seed + i - 1) %>%   # NEW: was real patients' traits resampled; POOL: seed + i - 1 (new traits per dataset)
        apply_boxcox_parallel_r(boxcox_params, var_types[cond_vars]) %>%
        standardize_data_r(marginals, var_types[cond_vars])
      C_new  <- encode_features(synthetic_cond, marginals, var_types[cond_vars])$matrix
      X_real <- cbind(1, C_train)
      z_coef <- MASS::ginv(X_real) %*% z_real[[1]]                   # least squares (ginv: one-hot columns collinear)
      z_samples <- cbind(1, C_new) %*% z_coef +
        matrix(MASS::mvrnorm(n_patients, rep(0, latent_dim), cov(z_real[[1]] - X_real %*% z_coef) + post_var),
               ncol = latent_dim)
    } else {                                                          # z from where real patients' z lie
      z_samples <- matrix(MASS::mvrnorm(n_patients, colMeans(z_real[[1]]), cov(z_real[[1]]) + post_var),
                          ncol = latent_dim)
    }

    # Step 9: Generate synthetic data
    decoded <- decoder %>% predict(if (has_cond) list(z_samples, C_new) else z_samples, verbose = 0)
    decoded_matrix <- sequences_to_matrix(decoded)
    colnames(decoded_matrix) <- colnames(seq_matrix)

    # Step 9b: Draw which visits exist and which values are missing  # NEW
    pid <- rep(seq_len(n_patients), each = n_timepoints)
    visit_draw <- if (all(data_grid$.visit == 1)) rep(1, nrow(decoded_matrix)) else rbinom(nrow(decoded_matrix), 1, decoded_matrix[, ".visit"])
    no_visit <- setdiff(seq_len(n_patients), unique(pid[visit_draw == 1]))
    visit_draw[map_int(no_visit, ~ which(pid == .x)[which.max(decoded_matrix[pid == .x, ".visit"])])] <- 1  # at least one visit
    observed_draw <- map(set_names(names(seq_types)), function(var) {
      p_obs <- decoded_matrix[, paste0(var, "__observed")]
      if (all(obs_mask[data_grid$.visit == 1, paste0(var, "__observed")] == 1)) return(rep(1, length(p_obs)))
      if (var %in% static_vars) rbinom(n_patients, 1, tapply(p_obs, pid, mean))[pid] else rbinom(length(p_obs), 1, p_obs)
    })

    synthetic_data <- decode_features(decoded_matrix[, colnames(encoded$matrix), drop = FALSE], encoded, marginals,
                                      static_vars, n_timepoints, noise, cat_persistence) %>%   # NEW: structured noise
      mutate(across(all_of(names(seq_types)), ~ replace(.x, observed_draw[[cur_column()]] == 0, NA)))   # NEW: missingness
    if (has_cond) {
      synthetic_data <- bind_cols(synthetic_data, synthetic_cond[pid, ])                   # NEW: traits back
    }

    # Step 10: Back to the original scale                            # CHANGED (fix 1, 2): was inverse standardize
    synthetic_data <- map_to_observed_r(synthetic_data, value_maps)  # + inverse Box-Cox (gave NaN, ignored bounds)

    # Step 11: Add fake IDs and time structure
    synthetic_data <- synthetic_data %>%
      mutate(
        patient_id = rep(sample(10000:99999, n_patients, replace = FALSE), each = n_timepoints),
        .time = rep(time_grid, n_patients)                         # CHANGED: real grid values (was 1:n_timepoints)
      ) %>%
      filter(visit_draw == 1) %>%                                   # NEW: keep drawn visits only
      select(patient_id, .time, all_of(vars)) %>%
      rename(!!time_var := .time)

    cat(sprintf("✓ Generated %d patients, %d visits (original scale)\n", n_patients, nrow(synthetic_data)))

    attr(synthetic_data, "history") <- history                   # NEW: for checking convergence
    synthetic_data
  }

  syn_list <- map(seq_len(m), draw_one)                           # NEW (pooling): m datasets from one trained model
  if (m == 1) syn_list[[1]] else syn_list                         # NEW: m = 1 returns a data frame, as before
}
