## Generator: model architecture

```{r generator-model}
# Sampling layer: reparameterization trick + weighted KL loss     # NEW (replaces layer_lambda, keras3)
layer_sampling_kl <- Layer(
  classname = "SamplingKL",
  initialize = function(seed = 1066, ...) {
    super$initialize(...)
    self$seed_generator <- random_seed_generator(seed)
    self$kl_weight <- self$add_weight(shape = shape(), initializer = "zeros", trainable = FALSE, name = "kl_weight")
  },
  call = function(inputs) {
    z_mean <- inputs[[1]]
    z_log_var <- inputs[[2]]
    kl <- -0.5 * op_mean(op_sum(1 + z_log_var - op_square(z_mean) - op_exp(z_log_var), axis = -1))
    self$add_loss(self$kl_weight * kl)
    epsilon <- random_normal(shape = op_shape(z_mean), seed = self$seed_generator)
    z_mean + op_exp(0.5 * z_log_var) * epsilon
  }
)

# KL warm-up: weight rises linearly from 0 to beta over warmup epochs   # NEW
callback_kl_warmup <- Callback(
  classname = "KLWarmup",
  initialize = function(warmup, beta = 1) {
    super$initialize()
    self$warmup <- warmup
    self$beta <- beta
  },
  on_epoch_begin = function(epoch, logs = NULL) {
    self$model$get_layer("z_sampling")$kl_weight$assign(self$beta * min(1, epoch / max(1, self$warmup)))
  }
)

build_temporal_vae <- function(n_timepoints, encoded, latent_dim = 8,
                               n_cond = 0,                                       # NEW: conditioning columns
                               seq_vars = c(encoded$continuous_vars, encoded$categorical_vars)) {  # NEW
  #' Build Temporal VAE with LSTM encoder/decoder. If n_cond > 0 it is a conditional VAE: the patient
  #' traits go to the encoder (at every time point) and to the decoder (with z).
  #' Feature layout (input and output): value columns | one "observed" column per variable | visit column.

  n_values   <- ncol(encoded$matrix)                                # NEW
  n_vars     <- length(seq_vars)
  n_features <- n_values + n_vars + 1                               # CHANGED: values | observed | visit
  n_cont     <- length(encoded$continuous_vars)
  to_tensor  <- function(x) op_convert_to_tensor(x, dtype = "float32")
  cont_mask  <- to_tensor(c(rep(1, n_cont), rep(0, n_values - n_cont), rep(0, n_vars + 1)))
  cat_mask   <- to_tensor(c(rep(0, n_cont), rep(1, n_values - n_cont), rep(0, n_vars + 1)))
  obs_cols   <- to_tensor(c(rep(0, n_values), rep(1, n_vars), 0))
  visit_col  <- to_tensor(c(rep(0, n_values + n_vars), 1))
  val_names  <- colnames(encoded$matrix)                            # maps each "observed" column to its value columns
  obs_map <- rbind(matrix(0, n_values, n_features),
                   do.call(rbind, map(seq_vars, ~ c(as.numeric(val_names == .x | startsWith(val_names, paste0(.x, "__"))),
                                                    rep(0, n_vars + 1)))),
                   matrix(0, 1, n_features)) %>% to_tensor()

  # Encoder
  input_layer <- keras_input(shape = c(n_timepoints, n_features))
  if (n_cond > 0) {                                                 # NEW: traits at every time point
    cond_input <- keras_input(shape = n_cond)
    encoder_in <- layer_concatenate(list(input_layer, cond_input %>% layer_repeat_vector(n_timepoints)))
  } else {
    encoder_in <- input_layer
  }

  encoded_seq <- encoder_in %>%
    layer_lstm(64, return_sequences = TRUE) %>%      # CHANGED: default tanh (was relu); no dropout (was 0.2)
    layer_lstm(32, return_sequences = FALSE)         # CHANGED: default tanh (was relu)

  # Latent space
  z_mean    <- encoded_seq %>% layer_dense(latent_dim, name = "z_mean")
  z_log_var <- encoded_seq %>% layer_dense(latent_dim, name = "z_log_var")

  # Sampling layer
  z_sampling <- layer_sampling_kl(list(z_mean, z_log_var), name = "z_sampling")

  # Decoder
  latent_input <- keras_input(shape = latent_dim)
  if (n_cond > 0) {                                                 # NEW: decoder gets z + traits
    dec_cond_input <- keras_input(shape = n_cond)
    decoder_in <- layer_concatenate(list(latent_input, dec_cond_input))
  } else {
    decoder_in <- latent_input
  }

  decoded <- decoder_in %>%
    layer_dense(32, activation = "relu") %>%
    layer_repeat_vector(n_timepoints) %>%
    layer_lstm(64, return_sequences = TRUE)          # CHANGED: default tanh (was relu); no dropout (was 0.2)

  # Output heads: linear (continuous), softmax per categorical, sigmoid for observed / visit   # CHANGED (was one sigmoid layer)
  output_list <- c(
    if (n_cont > 0) list(decoded %>% layer_dense(n_cont)),
    map(encoded$cat_sizes, ~ decoded %>% layer_dense(.x, activation = "softmax")),
    list(decoded %>% layer_dense(n_vars, activation = "sigmoid"),
         decoded %>% layer_dense(1, activation = "sigmoid"))
  )
  decoder_outputs <- layer_concatenate(output_list)

  # Decoder model
  decoder <- keras_model(if (n_cond > 0) list(latent_input, dec_cond_input) else latent_input,
                         decoder_outputs, name = "decoder")

  # Full VAE model
  vae <- if (n_cond > 0) {
    keras_model(list(input_layer, cond_input), decoder(list(z_sampling, cond_input)), name = "temporal_vae")
  } else {
    keras_model(input_layer, decoder(z_sampling), name = "temporal_vae")
  }

  # VAE loss: reconstruction (KL is added by the sampling layer)   # CHANGED: masked; per-type terms
  # squared error (continuous) + cross-entropy (categorical) on observed values only,
  # + binary cross-entropy for "value observed" (at visits) and "visit exists" (all slots)
  vae_loss <- function(x_true, x_pred) {
    visit   <- op_sum(x_true * visit_col, axis = -1, keepdims = TRUE)
    val_wt  <- op_matmul(x_true, obs_map) * visit
    sq_err  <- op_square(x_true - x_pred) * cont_mask * val_wt
    x_ent   <- -x_true * op_log(op_clip(x_pred, 1e-7, 1)) * cat_mask * val_wt
    bce     <- -(x_true * op_log(op_clip(x_pred, 1e-7, 1)) + (1 - x_true) * op_log(op_clip(1 - x_pred, 1e-7, 1)))
    op_sum(op_sum(sq_err + x_ent + bce * obs_cols * visit + bce * visit_col, axis = -1), axis = -1)
  }

  vae %>% compile(optimizer = "adam", loss = vae_loss)

  return(vae)
}
```

## Generator: helper functions

```{r generator-helpers}
auto_detect_var_types <- function(data) {
  map(data, function(x) {
    if (is.numeric(x)) "continuous"
    else if (is.character(x) || is.factor(x)) "categorical"
    else "other"
  })
}

synthesize_traits <- function(real_cond, cond_types, n_patients, seed) {   # NEW (privacy)
  #' Synthetic patient traits (one row per patient) with synthpop CART, so no real patient's trait combination is
  #' copied. Continuous traits are smoothed (density), so exact real values are not reused either.
  syn_in <- real_cond %>% mutate(across(all_of(names(cond_types)[cond_types == "categorical"]), factor)) %>% as.data.frame()
  smooth <- map(set_names(names(cond_types)[cond_types == "continuous"]), ~ "density")
  if (length(smooth) == 0) smooth <- NULL
  syn_out <- synthpop::syn(syn_in, k = n_patients, seed = seed, smoothing = smooth, print.flag = FALSE)$syn
  syn_out %>% mutate(across(everything(), function(x) {            # back to each trait's original class
    orig <- real_cond[[cur_column()]]
    if (is.factor(orig)) factor(x, levels = levels(orig)) else if (is.numeric(orig)) as.numeric(as.character(x)) else as.character(x)
  })) %>% as_tibble()
}

detect_static_vars <- function(data, vars) {                       # NEW
  #' Variables with a single (non-missing) value within every patient
  data %>%
    group_by(patient_id) %>%
    summarise(across(all_of(vars), ~ n_distinct(.x, na.rm = TRUE)), .groups = "drop") %>%
    select(-patient_id) %>%
    map_lgl(~ all(.x <= 1)) %>%
    which() %>%
    names()
}

fit_boxcox_parallel_r <- function(data, var_types) {
  continuous_vars <- names(var_types[var_types == "continuous"])

  boxcox_list <- map(continuous_vars, function(var) {
    fit_boxcox_single_r(data[[var]], var)
  })

  names(boxcox_list) <- continuous_vars

  full_params <- map(names(var_types), function(var) {
    if (var %in% continuous_vars) boxcox_list[[var]]
    else list(lambda = NA, shift = 0, fitted = FALSE)
  })
  names(full_params) <- names(var_types)

  return(full_params)
}

fit_boxcox_single_r <- function(vals, var_name) {
  tryCatch({
    vals <- as.numeric(vals)
    vals <- vals[!is.na(vals)]

    if (any(vals <= 0)) {
      shift <- abs(min(vals)) + 1
      vals <- vals + shift
    } else {
      shift <- 0
    }

    pt <- car::powerTransform(vals)
    lambda <- pt$lambda

    list(lambda = lambda, shift = shift, fitted = TRUE)
  }, error = function(e) {
    cat(sprintf("  Warning: Box-Cox failed for %s\n", var_name))
    list(lambda = 1, shift = 0, fitted = FALSE)
  })
}

apply_boxcox_parallel_r <- function(data, boxcox_params, var_types) {
  continuous_vars <- names(var_types[var_types == "continuous"])

  transformed_vars <- map(continuous_vars, function(var) {
    boxcox_transform_single_r(data[[var]], boxcox_params[[var]])
  })
  names(transformed_vars) <- continuous_vars

  result <- data %>% select(-all_of(continuous_vars))

  map2(continuous_vars, transformed_vars, function(var, vals) {
    result[[var]] <<- vals
  })

  result %>% select(all_of(names(data)))
}

boxcox_transform_single_r <- function(vals, boxcox_param) {
  lambda <- boxcox_param$lambda
  shift <- boxcox_param$shift
  vals_shifted <- vals + shift

  if (abs(lambda) < 1e-6) log(vals_shifted)
  else (vals_shifted^lambda - 1) / lambda
}

fit_marginals_r <- function(data, var_types) {
  map2(names(var_types), var_types, function(var, type) {
    if (type == "continuous") {
      list(type = "continuous", mean = mean(data[[var]], na.rm = TRUE), sd = sd(data[[var]], na.rm = TRUE))  # CHANGED: na.rm
    } else if (type == "categorical") {
      unique_vals <- sort(unique(data[[var]]))
      list(type = "categorical", levels = unique_vals, n_levels = length(unique_vals))
    }
  }) %>%
    set_names(names(var_types))   # CHANGED: added so marginals[[var]] works
}

standardize_data_r <- function(data, marginals, var_types) {
  continuous_vars <- names(var_types[var_types == "continuous"])
  data %>%                                                         # CHANGED: across() instead of for loop
    mutate(across(all_of(continuous_vars),
                  ~ (.x - marginals[[cur_column()]]$mean) / marginals[[cur_column()]]$sd))
}

encode_features <- function(data, marginals, var_types) {          # NEW
  #' Continuous columns as-is; categorical columns one-hot (named var__level; missing = all zeros)
  continuous_vars  <- names(var_types[var_types == "continuous"])
  categorical_vars <- names(var_types[var_types == "categorical"])
  cat_blocks <- map(categorical_vars, function(var) {
    lv <- marginals[[var]]$levels
    m <- outer(as.character(data[[var]]), as.character(lv), "==") * 1
    m[is.na(m)] <- 0
    colnames(m) <- paste0(var, "__", lv)
    m
  })
  mat <- do.call(cbind, c(list(as.matrix(data[continuous_vars])), cat_blocks))
  storage.mode(mat) <- "double"
  list(matrix = mat, continuous_vars = continuous_vars, categorical_vars = categorical_vars,
       cat_sizes = map_int(categorical_vars, ~ marginals[[.x]]$n_levels))
}

reshape_to_sequences <- function(mat, n_patients, n_timepoints) {  # CHANGED: no for loop
  #' Rows ordered patient-major, time-minor -> array [patient, time, feature]
  aperm(array(mat, dim = c(n_timepoints, n_patients, ncol(mat))), c(2, 1, 3))
}

sequences_to_matrix <- function(arr) {                             # NEW
  #' Array [patient, time, feature] -> rows ordered patient-major, time-minor
  matrix(aperm(arr, c(2, 1, 3)), ncol = dim(arr)[3])
}

sample_categories <- function(p, u = runif(nrow(p))) {             # NEW (u: CHANGED, added for fix 4)
  #' One category index per row from a matrix of probabilities, using uniform numbers u
  p <- p / rowSums(p)
  cum <- p %*% upper.tri(diag(ncol(p)), diag = TRUE)               # row-wise cumulative sums
  pmin(rowSums(u > cum) + 1, ncol(p))
}

ar1_series <- function(n_patients, n_timepoints, rho) {             # NEW (fix 3, 4)
  #' Standard-normal AR(1) series per patient (lag-1 correlation rho), rows patient-major, time-minor
  e <- matrix(rnorm(n_patients * n_timepoints), n_timepoints)        # time x patient
  e[-1, ] <- e[-1, ] * sqrt(1 - rho^2)                              # keeps variance 1 at every step
  as.vector(apply(e, 2, stats::filter, filter = rho, method = "recursive"))
}

estimate_noise_structure <- function(vae_model, model_x, X_train, encoded, col_names,
                                     static_vars, n_timepoints) {    # NEW (fix 3)
  #' Reconstruct the real patients from z_mean and describe, per continuous variable, what the model misses:
  #' patient-level intercept and slope (covariance G), lag-1 correlation of the rest (rho) and its SD (sigma),
  #' from lmer(residual ~ 1 + time + (1 + time | patient)) on observed values (standardized scale).
  decoder <- get_layer(vae_model, "decoder")
  z_mean_out <- get_layer(vae_model, "z_mean")$output
  mean_model <- keras_model(vae_model$inputs,
                            decoder(if (is.list(model_x)) list(z_mean_out, vae_model$inputs[[2]]) else z_mean_out))
  X_mat <- sequences_to_matrix(X_train); colnames(X_mat) <- col_names
  resid <- X_mat - sequences_to_matrix(mean_model %>% predict(model_x, verbose = 0)); colnames(resid) <- col_names
  pid <- rep(seq_len(dim(X_train)[1]), each = n_timepoints)
  tt  <- rep((seq_len(n_timepoints) - 1) / max(1, n_timepoints - 1), dim(X_train)[1])
  map(set_names(encoded$continuous_vars), function(v) {
    obs <- X_mat[, paste0(v, "__observed")] == 1
    d <- tibble(r = resid[obs, v], tt = tt[obs], pid = pid[obs])
    if (v %in% static_vars) return(list(static_sd = sd(tapply(d$r, d$pid, mean)), G = matrix(0, 2, 2), rho = 0, sigma = 0))
    fit <- tryCatch(suppressWarnings(suppressMessages(lme4::lmer(r ~ 1 + tt + (1 + tt | pid), d, REML = FALSE))),
                    error = function(e) NULL)
    if (is.null(fit)) return(list(G = matrix(0, 2, 2), rho = 0, sigma = sd(d$r), static_sd = 0))
    e <- tibble(pid = d$pid, tt = d$tt, e = resid(fit)) %>% group_by(pid) %>%
      mutate(prev = lag(e), gap = tt - lag(tt)) %>% ungroup() %>%
      filter(abs(gap - 1 / max(1, n_timepoints - 1)) < 1e-9)          # consecutive grid slots only
    rho <- if (nrow(e) > 10) min(max(cor(e$e, e$prev), 0), 0.95) else 0
    list(G = as.matrix(lme4::VarCorr(fit)$pid)[1:2, 1:2], rho = rho, sigma = sigma(fit), static_sd = 0)
  })
}

estimate_cat_persistence <- function(data_grid, categorical_vars, static_vars) {   # NEW (fix 4)
  #' Per time-varying categorical variable: how strongly a patient's value persists from one visit to the
  #' next (lag-1 correlation of "same as the most common level" between consecutive visits), converted to the
  #' correlation of the underlying normal (sin(pi/2 * r), Greiner's relation). Used to draw categories with
  #' AR(1) random numbers so values do not flip at random between days.
  map_dbl(set_names(setdiff(categorical_vars, static_vars)), function(v) {
    d <- data_grid %>% filter(!is.na(.data[[v]])) %>%
      mutate(top = as.numeric(.data[[v]] == names(which.max(table(.data[[v]]))))) %>%
      group_by(patient_id) %>% mutate(prev = lag(top)) %>% ungroup() %>% filter(!is.na(prev))
    r <- if (nrow(d) > 10 && sd(d$top) > 0 && sd(d$prev) > 0) cor(d$top, d$prev) else 0
    min(max(sin(pi / 2 * r), 0), 0.99)
  })
}

decode_features <- function(mat, encoded, marginals, static_vars, n_timepoints,
                            noise = NULL, cat_persistence = NULL) {  # NEW (noise, cat_persistence: fix 3, 4)
  #' Decoder output -> tibble on the standardized Box-Cox scale (categorical as levels).
  #' Time-invariant variables: one value per patient. Continuous: + patient-level intercept/slope noise
  #' + AR(1) noise (fix 3). Time-varying categorical: drawn with AR(1) random numbers (fix 4).
  n_pat <- nrow(mat) / n_timepoints
  pid <- rep(seq_len(n_pat), each = n_timepoints)
  tt  <- rep((seq_len(n_timepoints) - 1) / max(1, n_timepoints - 1), n_pat)

  cont <- map(set_names(encoded$continuous_vars), function(var) {
    v <- mat[, var]
    s <- noise[[var]]
    if (var %in% static_vars) return(ave(v, pid) + rnorm(n_pat, 0, if (is.null(s)) 0 else s$static_sd)[pid])
    if (is.null(s)) return(v)
    ab <- MASS::mvrnorm(n_pat, c(0, 0), s$G)                       # patient intercept and slope
    v + ab[pid, 1] + ab[pid, 2] * tt + s$sigma * ar1_series(n_pat, n_timepoints, s$rho)
  })

  cats <- map(set_names(encoded$categorical_vars), function(var) {
    lv <- marginals[[var]]$levels
    p <- mat[, paste0(var, "__", lv), drop = FALSE]
    idx <- if (var %in% static_vars) {
      sample_categories(rowsum(p, pid) / n_timepoints)[pid]
    } else {
      rho <- if (is.null(cat_persistence)) 0 else cat_persistence[[var]]
      sample_categories(p, pnorm(ar1_series(n_pat, n_timepoints, rho)))   # CHANGED (fix 4): persistent draws
    }
    lv[idx]
  })

  as_tibble(c(cont, cats))
}

build_value_maps <- function(data_orig, data_std, var_types) {      # NEW (fix 1, 2)
  #' For each continuous variable: its observed values paired with their standardized Box-Cox values (sorted),
  #' and how to format output values: snap = TRUE if 30 or fewer distinct values; else round to observed decimals.
  continuous_vars <- names(var_types[var_types == "continuous"])
  map(set_names(continuous_vars), function(var) {
    keep  <- !is.na(data_orig[[var]])
    pairs <- distinct(tibble(std = data_std[[var]][keep], orig = data_orig[[var]][keep])) %>% arrange(std)
    support <- sort(unique(pairs$orig))
    list(std = pairs$std, orig = pairs$orig, snap = length(support) <= 30,
         digits = detect(0:6, ~ all(abs(support * 10^.x - round(support * 10^.x)) < 1e-8), .default = 6),
         orig_all = sort(data_orig[[var]][keep]))
  })
}

map_to_observed_r <- function(data, value_maps) {                  # NEW (fix 1, 2)
  #' Standardized Box-Cox scale -> original scale by interpolating between observed (std, value) pairs: the same
  #' as the inverse Box-Cox inside the observed range, held at the observed min / max outside it (no NaN).
  #' Discrete variables (30 or fewer values) are mapped by rank, so each value keeps its real share.
  data %>%
    mutate(across(all_of(names(value_maps)), function(y) {
      m <- value_maps[[cur_column()]]
      if (length(m$orig) < 2) return(ifelse(is.na(y), NA, m$orig[1]))
      if (m$snap) {
        p <- (rank(y, na.last = "keep", ties.method = "random") - 0.5) / sum(!is.na(y))
        ifelse(is.na(y), NA, quantile(m$orig_all, p, type = 1, names = FALSE))
      } else {
        round(approx(m$std, m$orig, xout = y, rule = 2, ties = mean)$y, m$digits)
      }
    }))
}
